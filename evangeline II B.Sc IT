PROGRAM 1

def create_grid(size=10):
    return [[0 for _ in range(size)] for _ in range(size)]

def draw_square(grid, size, x, y):
    for i in range(size):
        for j in range(size):
            if 0 <= x + i < len(grid) and 0 <= y + j < len(grid[0]):
                grid[x + i][y + j] = 1

def draw_triangle(grid, size, x, y):
    for i in range(size):
        for j in range(i + 1):
            if 0 <= x + i < len(grid) and 0 <= y + j < len(grid[0]):
                grid[x + i][y + j] = 1

def display_grid(grid):
    for row in grid:
        print(" ".join(map(str, row)))

# Example usage
grid = create_grid()

shape = input("Enter shape (square/triangle): ").strip().lower()
x, y = map(int, input("Enter position (x y): ").split())
size = int(input("Enter size: "))

if shape == "square":
    draw_square(grid, size, x, y)
elif shape == "triangle":
    draw_triangle(grid, size, x, y)
else:
    print("Unsupported shape!")

display_grid(grid)


PROGRAM 2


def process_string(input_str):
    words = input_str.split()
    result = []

    for i, word in enumerate(words):
        if i % 2 == 0:
            # Replace vowels in every alternate word
            word = ''.join('*' if char.lower() in 'aeiou' else char for char in word)
        else:
            # Reverse every second word
            word = word[::-1]
        result.append(word)

    return ' '.join(result)

# Example usage
input_str = input("Enter a string: ")
output_str = process_string(input_str)
print("Processed string:", output_str)
